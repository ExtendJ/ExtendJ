aspect CaptureConversionCodegen {
  /**
   * A capture variable is not declared by any class, interface, method, or
   * constructor, so it cannot be referenced by name from a bytecode signature
   * (JVMS SE8 §4.7.9.1). The erasure of the capture variable is used instead.
   */
  eq CaptureVariable.classTypeSignature() = erasure().classTypeSignature();
}
