/**
 * A fresh inference variable created during the resolution step of type
 * inference (see {@link BoundSet#resolve()}, JLS SE8 §18.4).
 *
 * <p>Unlike a declared type variable a fresh variable can have a lower bound.
 */
FreshVariable : TypeVariable ::= LowerBound:Access*;

/**
 * A capture variable is the fresh type variable a wildcard type argument is
 * replaced by during capture conversion (JLS SE8 §5.1.10).
 *
 * <p>A capture variables can have a lower bound when created from a lower
 * bounded (super) wildcard.
 */
CaptureVariable : FreshVariable;
