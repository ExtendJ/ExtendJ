// SPDX-License-Identifier: BSD-3-Clause

// Here are helper attributes for JLS SE8 type inference.
// Most of the work is done inside the BoundSet class.
aspect TypeInference_SE8 {
  /**
   * Create fresh variables {@code Y1, ..., Yn} to be used in bound set resolution
   * ({@link BoundSet#resolve()}) and capture bound creation.
   *
   * <p>The variables are created with (optional) upper/lower bounds.
   * The whole group needs to be created as a single unit because the bounds can be
   * mutually recursive in their upper bounds ({@code Yi <: glb(U1 θ, ..., Uk θ)} where
   * θ is the substitution {@code [α1:=Y1, ..., αn:=Yn]}).
   * For example, a self-bounded variable {@code <T extends Comparable<T>>} gives
   * {@code Y1 <: Comparable<Y1>}.
   *
   * <p>Memoized so that re-evaluated inference (fixpoint iteration in
   * {@code Expr.resolve}) gets the same variables.
   *
   * @param context The invocation whose inference creates the variables.
   * @param vars The inference variables {@code α1, ..., αn} being replaced, or
   * the capture bound argument types.
   * @param lowerBounds The lower bound of each Yi before substitution, or {@code null}
   * for a variable that has no proper lower bound.
   * @param upperBounds The upper bound of each Yi before substitution, or {@code null}
   * for a variable that has no upper bound.
   */
  inh List<FreshVariable> Expr.lookupFreshVars(
      Expr context,
      ArrayList<TypeDecl> vars,
      ArrayList<TypeDecl> lowerBounds,
      ArrayList<TypeDecl> upperBounds);

  eq Program.getChild().lookupFreshVars(Expr context, ArrayList<TypeDecl> vars, ArrayList<TypeDecl> lowerBounds, ArrayList<TypeDecl> upperBounds) =
      wildcards().lookupFreshVars(context, vars, lowerBounds, upperBounds);

  syn nta List<FreshVariable> WildcardsCompilationUnit.lookupFreshVars(
      Expr context,
      ArrayList<TypeDecl> vars,
      ArrayList<TypeDecl> lowerBounds,
      ArrayList<TypeDecl> upperBounds) {
    // TODO(joqvist): We really should re-design Parameterization so that it can be reused here
    // instead of using Map<TypeVariable, TypeDecl> to represent the substitution.
    int n = vars.size();
    List<FreshVariable> fresh = new List<>();
    for (int i = 0; i < n; ++i) {
      fresh.add(new FreshVariable(
          new Modifiers(new List().add(new Modifier("public"))),
          String.format("fresh#(%s)", vars.get(i).typeName()),
          new List<BodyDecl>(),
          new List<Access>(),
          new List<Access>()));
    }
    Map<TypeVariable, TypeDecl> theta = new LinkedHashMap<>();
    for (int i = 0; i < n; ++i) {
      if (vars.get(i) instanceof TypeVariable) {
        theta.put((TypeVariable) vars.get(i), fresh.getChild(i));
      }
    }
    for (int i = 0; i < n; ++i) {
      FreshVariable Yi = fresh.getChild(i);
      TypeDecl upper = i < upperBounds.size() ? upperBounds.get(i) : null;
      if (upper != null) {
        Yi.setBoundList(new List<>(upper.substituted(theta).createBoundAccess()));
      }
      TypeDecl lower = i < lowerBounds.size() ? lowerBounds.get(i) : null;
      if (lower != null) {
        Yi.setLowerBoundList(new List<>(lower.substituted(theta).createBoundAccess()));
      }
    }
    return fresh;
  }

  /**
   * The result type of the referenced method given the targeted function descriptor
   * {@code fd}, used to reduce a method reference compatibility constraint during
   * type inference.
   *
   * @return {@code UnknownType} when no applicable referenced method is found.
   */
  syn TypeDecl MethodReference.invocationType(FunctionDescriptor fd) = compileTimeDeclaration(fd).type();

  /** See {@code MethodReference.invocationType}. */
  syn TypeDecl ConstructorReference.invocationType(FunctionDescriptor fd) = unknownType();

  eq ClassReference.invocationType(FunctionDescriptor fd) {
    if (fd.method.isUnknown()) return unknownType();
    ConstructorDecl decl = targetConstructor(fd);
    return unknownConstructor() == decl ? unknownType() : syntheticInstanceExpr(fd).type();
  }

  eq ArrayCtorRef.invocationType(FunctionDescriptor fd) = getTypeAccess().type();

  /**
   * Create a synthetic {@code MethodAccess} representing the implicit invocation
   * that would be used to call the method reference given the target function descriptor {@code fd}.
   *
   * <p>This is used in lifting bounds from the target function descriptor into
   * an enclosing bound set during type inference.
   *
   * @return {@code null} if the target method is unknown.
   */
  syn MethodAccess MethodReference.implicitInvocation(FunctionDescriptor fd) = null;

  eq ExprMethodReference.implicitInvocation(FunctionDescriptor fd) {
    if (fd.method.isUnknown()) return null;
    return syntheticMethodAccess(fd);
  }

  eq TypeMethodReference.implicitInvocation(FunctionDescriptor fd) {
    if (fd.method.isUnknown()) return null;
    boolean hasStatic = !targetStaticMethod(fd).isUnknown();
    boolean hasInstance = !targetInstanceMethod(fd).isUnknown();
    if (hasStatic && !hasInstance) return syntheticStaticMethodAccess(fd);
    if (!hasStatic && hasInstance) return syntheticInstanceMethodAccess(fd);
    return null;
  }

  syn lazy Set<MethodInferenceNode> MethodAccess.potentiallyApplicable(TypeDecl targetType) {
    HashSet<MethodInferenceNode> methods = new HashSet<>();
    Iterable<MethodDecl> candidates = lookupMethod(name());
    for (MethodDecl method : candidates) {
      if (potentiallyApplicable(method) && accessible(method)) {
        if (!method.hasVarargsParameter()) {
          addInferenceNode(methods, method, targetType);
        } else {
          if (getNumArg() == method.getNumParameter()) {
            addInferenceNode(methods, method, targetType);
          }
          addInferenceNode(methods, method.variableArityDecl(), targetType);
        }
      }
    }
    return methods;
  }

  protected void MethodAccess.addInferenceNode(HashSet<MethodInferenceNode> methods,
      MethodDecl method, TypeDecl targetType) {
    if (!method.isGeneric()) {
      methods.add(new MethodInferenceNode(method, new BoundSet(this)));
      return;
    }
    GenericMethodDecl gm = method.genericDecl();
    BoundSet bounds = gm.inferBounds(getArgList(), targetType, this);
    if (bounds.satisfiable) {
      methods.add(new MethodInferenceNode(gm, bounds));
    }
  }

  /**
   * Grounded lambda expression helps in binding a specific target type to a
   * lambda expression in the middle of (circular) type inference.
   */
  syn nta GroundedLambda LambdaExpr.groundedLambda(TypeDecl groundType) =
      new GroundedLambda(groundType.createBoundAccess(), (LambdaExpr) treeCopyNoTransform());

  eq GroundedLambda.getLambda().targetType() = getGroundType().type();

  eq GroundedLambda.type() = getGroundType().type();

  /**
   * Test if a constraint on this expression can have input variables (§18.5.2),
   * and thereby needs to be reduced in dependency order.
   */
  syn boolean Expr.hasConstraintInputVariables() = false;

  eq LambdaExpr.hasConstraintInputVariables() = true;

  eq MethodReference.hasConstraintInputVariables() = true;

  eq ConstructorReference.hasConstraintInputVariables() = true;

  eq ParExpr.hasConstraintInputVariables() = getExpr().hasConstraintInputVariables();

  eq ConditionalExpr.hasConstraintInputVariables() =
      getTrueExpr().hasConstraintInputVariables()
      || getFalseExpr().hasConstraintInputVariables();

  /**
   * Fill the out-argument {@code result} with all input variables
   * of the constraint {@code ‹this → T›} or
   * {@code ‹this →throws T›} according to {@code checkedThrows}.
   *
   * <p>Used in ordering constraints by variable dependencies.
   */
  public void Expr.constraintInputVariables(BoundSet bounds, TypeDecl T, boolean checkedThrows,
      Collection<TypeVariable> result) {
  }

  public void ParExpr.constraintInputVariables(BoundSet bounds, TypeDecl T, boolean checkedThrows,
      Collection<TypeVariable> result) {
    getExpr().constraintInputVariables(bounds, T, checkedThrows, result);
  }

  public void ConditionalExpr.constraintInputVariables(BoundSet bounds, TypeDecl T,
      boolean checkedThrows, Collection<TypeVariable> result) {
    getTrueExpr().constraintInputVariables(bounds, T, checkedThrows, result);
    getFalseExpr().constraintInputVariables(bounds, T, checkedThrows, result);
  }

  public void LambdaExpr.constraintInputVariables(BoundSet bounds, TypeDecl T, boolean checkedThrows,
      Collection<TypeVariable> result) {
    if (bounds.isInferenceVariable(T)) {
      result.add((TypeVariable) T);
      return;
    }
    if (!T.hasFunctionDescriptor()) {
      return;
    }
    FunctionDescriptor fd = T.functionDescriptor();
    if (isImplicit()) {
      for (ParameterDeclaration param : fd.method.getParameters()) {
        bounds.collectMentionedVars(param.type(), result);
      }
    }
    TypeDecl R = fd.method.type();
    if (checkedThrows) {
      bounds.collectMentionedVars(R, result);
    } else if (!R.isVoid()) {
      for (Expr expr : resultExpressions()) {
        expr.constraintInputVariables(bounds, R, false, result);
      }
    }
  }

  public void MethodReference.constraintInputVariables(BoundSet bounds, TypeDecl T,
      boolean checkedThrows, Collection<TypeVariable> result) {
    referenceInputVariables(bounds, T, checkedThrows, isExact(), result);
  }

  public void ConstructorReference.constraintInputVariables(BoundSet bounds, TypeDecl T,
      boolean checkedThrows, Collection<TypeVariable> result) {
    referenceInputVariables(bounds, T, checkedThrows, isExact(), result);
  }

  /** The input variables of a method or constructor reference constraint (§18.5.2). */
  public void Expr.referenceInputVariables(BoundSet bounds, TypeDecl T, boolean checkedThrows,
      boolean exact, Collection<TypeVariable> result) {
    if (bounds.isInferenceVariable(T)) {
      result.add((TypeVariable) T);
      return;
    }
    if (exact || !T.hasFunctionDescriptor()) {
      return;
    }
    FunctionDescriptor fd = T.functionDescriptor();
    for (ParameterDeclaration param : fd.method.getParameters()) {
      bounds.collectMentionedVars(param.type(), result);
    }
    if (checkedThrows) {
      bounds.collectMentionedVars(fd.method.type(), result);
    }
  }

  /** The expressions that give the result of this lambda (§15.27.2). */
  syn Collection<Expr> LambdaExpr.resultExpressions() {
    ArrayList<Expr> result = new ArrayList<>();
    if (getLambdaBody() instanceof ExprLambdaBody) {
      result.add(((ExprLambdaBody) getLambdaBody()).getExpr());
    } else {
      for (ReturnStmt returnStmt : ((BlockLambdaBody) getLambdaBody()).lambdaReturns()) {
        if (returnStmt.hasResult()) {
          result.add(returnStmt.getResult());
        }
      }
    }
    return result;
  }

  // TODO(joqvist): if targetType is not compatible with the declared return type do we return an unsatisfiable bound set?
  syn BoundSet MethodDecl.inferBounds(List<Expr> args, TypeDecl targetType, Expr context)
      = new BoundSet(context);

  /** Infer type bounds based on actual arguments. */
  eq GenericMethodDecl.inferBounds(List<Expr> args, TypeDecl targetType, Expr context) {
    BoundSet bounds = new BoundSet(context);
    collectBounds(bounds, args, targetType, context);
    addInvocationConstraints(bounds, args, context);
    bounds.resolve();
    return bounds;
  }

  /**
   * The unresolved bound set of this generic method invoked with {@code args} and
   * target type {@code type} in context {@code context}.
   *
   * <p>Lifted into the bound set of the ongoing inference which this is an argument of.
   */
  public BoundSet GenericMethodDecl.nestedInferenceBounds(List<Expr> args, TypeDecl type, Expr context) {
    BoundSet bounds = new BoundSet(context);
    collectBounds(bounds, args, type, context);
    addInvocationConstraints(bounds, args, context);
    return bounds;
  }

  /**
   * Fresh inference variables for this method's type parameters (JLS SE8 §18.1.1),
   * distinct from the declared type parameters.
   */
  syn nta List<TypeVariable> GenericMethodDecl.inferenceVariables(Expr context) {
    // TODO(joqvist): each separate invocation needs fresh inference variables
    List<TypeVariable> fresh = new List<TypeVariable>();
    for (TypeVariable p : getTypeParameterList()) {
      fresh.add((TypeVariable) p.treeCopyNoTransform());
    }
    return fresh;
  }

  /**
   * A parameterization of this method by its fresh inference variables, so that
   * the formal parameter types and the result type are expressed in terms of the
   * fresh inference variables rather than the declared type parameters.
   *
   * <p>The {@code context} parameter is used only as a memoization key
   */
  syn nta ParMethodDecl GenericMethodDecl.inferenceParMethodDecl(Expr context) {
    java.util.List<TypeDecl> args = new ArrayList<TypeDecl>();
    for (TypeVariable a : inferenceVariables(context)) {
      args.add(a);
    }
    return lookupParMethodDecl(args);
  }

  /**
   * Add this generic method's invocation applicability inference constraints
   * for {@code args} and {@code targetType} to {@code bounds}, without resolving them.
   *
   * <p>Not all type arguments will be inferred here. Deferred variables are
   * left to be reduced in a top-level resolved invocation.
   */
  public void GenericMethodDecl.collectBounds(BoundSet bounds, List<Expr> args,
      TypeDecl targetType, Expr context) {
    List<ParameterDeclaration> params = getParameterList();
    ParMethodDecl par = inferenceParMethodDecl(context);
    List<TypeVariable> typeParams = inferenceVariables(context);
    for (TypeVariable p : typeParams) {
      bounds.addTypeVariable(p);
    }
    // §18.5.1 (initial bounds)
    // For each type parameter P with bound B record constraint ‹P <: B›.
    for (int k = 0; k < typeParams.getNumChild(); ++k) {
      TypeVariable p = typeParams.getChild(k);
      TypeVariable substituted = getTypeParameter(k).substituted(par.getParameterization());
      boolean proper = false;
      for (int i = 0; i < substituted.getNumTypeBound(); ++i) {
        TypeDecl bound = substituted.getTypeBound(i).type();
        proper |= !bound.involvesTypeParameters();
        bounds.constraintSubtype(p, bound);
      }
      if (!proper) {
        // This is the 'Pl has no TypeBound' case from §18.1.3.
        bounds.constraintSubtype(p, typeObject());
      }
    }

    // §18.5.1 (initial bounds)
    // For each type parameter P appearing in the throws clause of this method the
    // bound ‹throws α› is implied for the inference variable α replacing P.
    for (int i = 0; i < getNumException(); ++i) {
      TypeDecl exception = getException(i).type();
      for (int k = 0; k < typeParams.getNumChild(); ++k) {
        if (exception == getTypeParameter(k)) {
          bounds.addThrowsBound(typeParams.getChild(k));
        }
      }
    }

    // §18.5.1 (applicability inference), restricted to the arguments that are
    // pertinent to applicability (§15.12.2.2).
    for (int i = 0; i < args.getNumChild(); ++i) {
      int k = i >= params.getNumChild() ? params.getNumChild() - 1 : i;
      Expr ei = args.getChild(i);
      if (!ei.pertinentToApplicability(context, this, k)) {
        continue;
      }
      bounds.constraintExprCompat(ei, par.formalType(i));
    }

    if (bounds.rawAccess) {
      // Unchecked conversion was necessary for the method to be applicable, so
      // the invocation type is the erasure of the method type.
      bounds.uncheckedConversion = true;
      return;
    }

    // §18.5.2: constrain the result type R against the target type T.
    TypeDecl T = targetType;
    if (!T.isUnknown()) {
      if (T.isUnboxedPrimitive()) {
        T = T.boxed();
      }
      TypeDecl R = par.type();
      if (R.isVoid()) {
        // TODO(joqvist): There is currently no test coverage for this branch.
        // §18.5.2 defines the result constraint only for non-void results.
        R = typeObject();
      }
      if (R.isParameterizedType()) {
        // If R θ is a parameterized type, G<A1, ..., An>, and one of A1, ..., An is a
        // wildcard, then, for fresh inference variables β1, ..., βn, the
        // constraint formula ‹G<β1, ..., βn> → T› is reduced and
        // incorporated, along with the bound G<β1, ..., βn> = capture(G<A1, ..., An>), with B2.
        bounds.maybeCaptureBound(R, T);
      } else {
        bounds.constraintTypeCompat(R, T);
      }
    }
    return;
  }

  /**
   * Add additional invocation constraints (JLS SE8 §18.5.2).
   */
  public void GenericMethodDecl.addInvocationConstraints(BoundSet bounds, List<Expr> args, Expr context) {
    if (!bounds.satisfiable) {
      return;
    }
    List<ParameterDeclaration> params = getParameterList();
    ParMethodDecl par = inferenceParMethodDecl(context);
    boolean ordered = false;
    ArrayList<BoundSet.Constraint> constraints = null;
    for (Expr arg : args) {
      if (arg.hasConstraintInputVariables()) {
        ordered = true;
        constraints = new ArrayList<>();
        break;
      }
    }
    for (int i = 0; i < args.getNumChild(); ++i) {
      TypeDecl Fi = par.formalType(i);
      int k = i >= params.getNumChild() ? params.getNumChild() - 1 : i;
      Expr ei = args.getChild(i);
      boolean compat = !ei.pertinentToApplicability(context, this, k);
      if (ordered) {
        if (compat) {
          constraints.add(BoundSet.compatibilityConstraint(ei, Fi)); // ‹ei → Fi θ›
        }
        if (ei.hasConstraintInputVariables()) {
          // The throws constraint reduces to true for other expression forms (§18.2.5),
          // and would only add phantom output variables to the dependency ordering.
          constraints.add(BoundSet.checkedThrowsConstraint(ei, Fi)); // ‹ei → throws Fi θ›
        }
      } else {
        // No argument constraint has input variables, so the constraints do not
        // have to be reduced in dependency order.
        if (compat) {
          bounds.constraintExprCompat(ei, Fi); // ‹ei → Fi θ›
        }
        bounds.constraintCheckedThrows(ei, Fi); // ‹ei → throws Fi θ›
      }
    }
    if (ordered) {
      bounds.reduceOrdered(constraints);
    }
  }

  /**
   * Reduce the bound set of this invocation, used as a poly-expression
   * argument with target type {@code type}, into the enclosing bound set
   * {@code outer}.
   *
   * <p>The default method resolves the invocation against the target type and merges its
   * resolved bound set. {@link MethodAccess} and {@link ClassInstanceExpr} override
   * this to lift an unresolved bound set instead, so the nested invocation is not
   * resolved before the enclosing one.
   *
   * @return {@code false} if the invocation cannot be resolved.
   */
  public boolean Expr.reduceInvocationBounds(BoundSet outer, TypeDecl type) {
    MethodInferenceNode node = resolve(type);
    if (node == MethodInferenceNode.UNRESOLVED) {
      return false;
    }
    outer.liftBounds(node.bounds);
    return true;
  }

  public boolean Dot.reduceInvocationBounds(BoundSet outer, TypeDecl type) {
    return getRight().reduceInvocationBounds(outer, type);
  }

  /**
   * In Java 8 a diamond class instance creation is inferred using the assignment
   * or invocation target type (§15.9.3).
   */
  refine Diamond eq DiamondAccess.type() {
    TypeDecl result = refined();
    if (getClassInstanceExpr() == null
        || !(getTypeAccess().type() instanceof ParClassDecl)) {
      return result;
    }
    // The Java 7 inference (refined() above) uses
    // only the constructor arguments, which can yield a type that is not assignable
    // to the target (e.g. HashSet<Sub> for a Set<Sup> target). In that case we re-infer
    // the chosen constructor's type arguments with the bound-set inference, which
    // incorporates the target type.
    TypeDecl tt = getClassInstanceExpr().targetType();
    if (tt.isUnknown() || result.isUnknown() || result.assignConversionTo(tt, getTypeAccess())) {
      // Typical case - no type inference needed.
      return result;
    }
    return targetInferredType(tt, result);
  }

  /**
   * Infer the diamond's type arguments from the constructor arguments and the
   * given target type (§15.9.3), returning {@code fallback} when no complete
   * non-raw type can be inferred.
   */
  public TypeDecl DiamondAccess.targetInferredType(TypeDecl target, TypeDecl fallback) {
    GenericMethodDecl gm = inferenceGenericMethod();
    if (gm != null) {
      BoundSet bounds = gm.inferBounds(methodAccess().getArgList(), target, methodAccess());
      if (bounds.satisfiable && !bounds.rawAccess
          && !bounds.typeArguments().contains(null)) {
        TypeDecl inferred = gm.lookupParMethodDecl(bounds.typeArguments()).type();
        if (!inferred.isUnknown()) {
          return inferred;
        }
      }
    }
    return fallback;
  }

  /**
   * The generic stand-in method (§15.9.3) of the chosen constructor for this
   * diamond, used to drive diamond type inference, or {@code null} when the
   * diamond does not resolve to a single generic constructor.
   */
  syn GenericMethodDecl DiamondAccess.inferenceGenericMethod() {
    if (!(getTypeAccess().type() instanceof ParClassDecl)) {
      return null;
    }
    SimpleSet<MethodDecl> ctor = chooseConstructor();
    if (!ctor.isSingleton()) return null;
    if (ctor.singletonValue() instanceof ParMethodDecl) {
      return ((ParMethodDecl) ctor.singletonValue()).getGenericMethodDecl();
    }
    return null;
  }

  public boolean ClassInstanceExpr.reduceInvocationBounds(BoundSet outer, TypeDecl targetType) {
    if (getAccess() instanceof DiamondAccess) {
      // A diamond class instance creation used as a nested argument.
      // Lift the bound set of its inferred constructor, targeting the enclosing formal
      // type, into the enclosing set, so that the diamond's type arguments are solved
      // together with the enclosing inference variables that the target mentions
      // (e.g. a nested diamond new Con<>(new Domain<>())).
      GenericMethodDecl gm = ((DiamondAccess) getAccess()).inferenceGenericMethod();
      if (gm != null && !outer.infersVariables(gm.inferenceVariables(this))) {
        MethodAccess synAccess = ((DiamondAccess) getAccess()).methodAccess();
        BoundSet nested = gm.nestedInferenceBounds(synAccess.getArgList(), targetType, synAccess);
        if (!nested.satisfiable) {
          return false;
        }
        outer.liftBounds(nested);
        return true;
      }
    }
    // A non-diamond or unresolved constructor invocation, or one nested inside an
    // inference of the same stand-in method, has a fixed result type.
    TypeDecl type = type();
    if (type.isUnknown()) {
      return false;
    }
    // The result type of a class instance creation is capture converted (§15.9.3).
    outer.constraintTypeCompat(capturedType(), targetType);
    return true;
  }

  public boolean MethodAccess.reduceInvocationBounds(BoundSet outer, TypeDecl targetType) {
    // Select the invoked method from its arguments alone (no target type).
    // The target type mentions the enclosing inference variables, which a standalone
    // resolution would treat as opaque and could spuriously reject.
    MethodInferenceNode node = resolve(unknownType());
    if (node == MethodInferenceNode.UNRESOLVED) {
      return false;
    }
    MethodDecl decl = node.decl;
    if (decl instanceof ParMethodDecl) {
      GenericMethodDecl gm = ((ParMethodDecl) decl).getGenericMethodDecl();
      if (!outer.infersVariables(gm.inferenceVariables(this))) {
        // Lift the chosen generic method's unresolved bound set targeting the real
        // target type.
        BoundSet nested = gm.nestedInferenceBounds(getArgList(), targetType, this);
        if (!nested.satisfiable) {
          return false;
        }
        outer.liftBounds(nested);
        return true;
      }
    }
    // A non-generic invocation, or one nested inside an inference of the same
    // generic method, has a fixed result type. The result type of a method
    // invocation is capture converted (§15.12.2.6).
    outer.constraintTypeCompat(capturedType(), targetType);
    return true;
  }

  /**
   * The formal parameter type that argument {@code i} is matched against, taking
   * variable arity into account.
   */
  protected TypeDecl MethodDecl.formalType(int i) {
    List<ParameterDeclaration> params = getParameterList();
    int k = i >= params.getNumChild() ? params.getNumChild() - 1 : i;
    ParameterDeclaration param = params.getChild(k);
    TypeDecl Fk = param.type();
    if (param instanceof VariableArityParameterDeclaration && isVariableArity()) {
      Fk = Fk.componentType();
    }
    return Fk;
  }

  /**
   * The parameterization of a generic method using resolved type arguments
   * from a (partial) inference result. Created as a synthetic substituted
   * declaration node.
   *
   * <p>Returns the raw method if an inference variable was left uninstantiated.
   * If unchecked conversion was necessary for applicability the parameter types
   * are still those of the inferred parameterization, only the result type is
   * erased (§18.5.2).
   */
  protected static MethodDecl MethodAccess.parameterizedDecl(MethodInferenceNode method) {
    GenericMethodDecl gm = (GenericMethodDecl) method.decl;
    Collection<TypeDecl> typeArgs = method.bounds.typeArguments();
    if (typeArgs.contains(null)) {
      method.decl = gm.rawMethodDecl();
    } else if (method.bounds.uncheckedConversion) {
      method.decl = gm.lookupUncheckedMethodDecl(typeArgs);
    } else {
      method.decl = gm.lookupParMethodDecl(typeArgs);
    }
    return method.decl;
  }

  /**
   * The invocation type of this generic method when unchecked conversion was
   * necessary for it to be applicable (§18.5.2).
   */
  syn nta UncheckedMethodDecl GenericMethodDecl.lookupUncheckedMethodDecl(
      Collection<TypeDecl> typeArguments) =
          (UncheckedMethodDecl) initParMethodDecl(new UncheckedMethodDecl(), typeArguments);

  /**
   * The result type is the erasure of the substituted result type rather than
   * the erasure of the declared one, which §18.5.2 asks for. Javac erases the
   * substituted type, so erasing the declared type would reject invocations
   * that javac accepts. See issue 348.
   *
   * <p>The thrown types need no equation as a thrown type is never a
   * parameterized type, so erasing the substituted thrown types leaves them
   * unchanged.
   */
  eq UncheckedMethodDecl.type() = erasedType(getTypeAccess().type());

  protected static MethodDecl MethodAccess.inferredDecl(MethodInferenceNode method) {
    if (method.decl.isGeneric()) {
      return parameterizedDecl(method);
    }
    return method.decl;
  }

  /**
   * Finds all different types returned by this lambda.
   */
  syn Collection<TypeDecl> LambdaBody.returnTypes();

  eq BlockLambdaBody.returnTypes() {
    Set<TypeDecl> types = null;
    for (ReturnStmt ret : lambdaReturns()) {
      if (ret.hasResult()) {
        if (types == null) {
          types = new HashSet<TypeDecl>();
        }
        types.add(ret.getResult().type());
      }
    }
    return types == null ? Collections.<TypeDecl>emptySet() : types;
  }

  eq ExprLambdaBody.returnTypes() = Collections.singleton(getExpr().type());

  /**
   * The resolved invocation of this expression when it targets {@code targetType}:
   * the chosen declaration together with its inference bound set.
   */
  syn lazy MethodInferenceNode Expr.resolve(TypeDecl targetType) =
      MethodInferenceNode.UNRESOLVED;

  // A qualified method invocation resolves through its rightmost access.
  eq Dot.resolve(TypeDecl targetType) = getRight().resolve(targetType);

  /**
   * Filter out the most specific declarations from a set of applicable methods.
   */
  public SimpleSet<MethodDecl> MethodAccess.mostSpecific(Set<MethodInferenceNode> methods) {
    SimpleSet<MethodDecl> maxSpecific = emptySet();

    // Phase 1: applicability by strict invocation.
    for (MethodInferenceNode method : methods) {
      MethodDecl decl = inferredDecl(method);
      if (applicableByStrictInvocation(decl)) {
        maxSpecific = mostSpecific(maxSpecific, decl);
      }
    }

    // Phase 2: applicability by loose invocation.
    if (maxSpecific.isEmpty()) {
      for (MethodInferenceNode method : methods) {
        MethodDecl decl = inferredDecl(method);
        if (applicableByLooseInvocation(decl)) {
          maxSpecific = mostSpecific(maxSpecific, decl);
        }
      }
    }

    // Phase 3: applicability by variable arity invocation.
    if (maxSpecific.isEmpty()) {
      for (MethodInferenceNode method : methods) {
        MethodDecl decl = inferredDecl(method);
        if (applicableByVariableArity(decl)) {
          maxSpecific = mostSpecific(maxSpecific, decl);
        }
      }
    }
    return maxSpecific;
  }

  eq MethodAccess.resolve(TypeDecl targetType) {
    Set<MethodInferenceNode> methods = potentiallyApplicable(targetType);
    SimpleSet<MethodDecl> maxSpecific = mostSpecific(methods);
    if (maxSpecific.isSingleton()) {
      MethodDecl chosen = maxSpecific.singletonValue();
      for (MethodInferenceNode method : methods) {
        if (method.decl == chosen) {
          return method;
        }
      }
    }
    return MethodInferenceNode.UNRESOLVED;
  }

  refine LookupMethod
  eq MethodAccess.decls() {
    if (this instanceof ParMethodAccess) {
      // A method invocation with explicit type arguments does not undergo type
      // inference. The Java 5 explicit-type-argument resolution is reused for this case.
      return refined();
    }
    TypeDecl tt = targetTypeInference() ? targetType() : unknownType();
    MethodInferenceNode method = resolve(tt);
    if (method == MethodInferenceNode.UNRESOLVED) {
      SimpleSet<MethodDecl> maxSpecific = mostSpecific(potentiallyApplicable(tt));
      if (maxSpecific.size() > 1) {
        return maxSpecific; // Ambiguous invocation.
      }
      return emptySet();
    }
    if (isQualified() ? qualifier().staticContextQualifier() : inStaticContext()) {
      if (!method.decl.isStatic()) {
        return emptySet();
      }
    }
    return method.decl;
  }
}
