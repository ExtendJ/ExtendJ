/**
 * A fresh type variable created by capture conversion or inference.
 * This type on its own is primarily used for Java 8 type inference.
 *
 * <p>Fresh type variables can have a lower bound, unlike {@link TypeVariable}.
 */
FreshVariable : TypeVariable ::= LowerBound:Access*;

/**
 * A capture variable is the fresh type variable a wildcard type argument is
 * replaced by during capture conversion.
 *
 * <p>A capture variables can have a lower bound when created from a lower
 * bounded (super) wildcard.
 */
CaptureVariable : FreshVariable;

/**
 * Sentinel for a capture variable whose bounds are not valid (e.g., malformed glb type).
 */
BadCapture : CaptureVariable;
