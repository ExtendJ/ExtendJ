// SPDX-License-Identifier: BSD-3-Clause

/**
 * Capture conversion (JLS3 §5.1.10) instantiates fresh type variables
 * for wildcard type arguments in expression types.
 *
 * Under capture conversion, type variables are substituted in wildcard bounds.
 * The {@code substituted} attribute is used to compute thes necessary substitutions.
 */
aspect CaptureConversion {
  /**
   * Counts the capture variables instantiated so far, to number them in
   * diagnostics. Each capture variable is instantiated once, since
   * {@code lookupCaptureTypes} is a memoized nonterminal attribute.
   */
  private int WildcardsCompilationUnit.captureCount = 0;

  /**
   * Instantiate the capture variables of the wildcard type arguments of the
   * type {@code type} captured at the capture site {@code site}.
   * The capture variables are returned in type argument
   * order, with the non-wildcard arguments skipped.
   *
   * <p>Capture conversion introduces fresh type variables each time it is
   * applied, so the capture variables are indexed by the site the conversion is
   * applied at.
   *
   * <p>The upper bounds of a capture variable are the declared bounds of the
   * corresponding type parameter of the captured type, with the type arguments
   * of the capture substituted (a bound can reference a sibling type
   * parameter). The capture variables are therefore created without bounds
   * first, and the bounds are added when all captures of the type are known.
   * The bound of the wildcard itself is a use site type and is not substituted.
   *
   * @param site The expression whose type is captured.
   * @param type The captured type, which is a parameterization of a generic type.
   */
  syn nta List<CaptureVariable> WildcardsCompilationUnit.lookupCaptureTypes(
      ASTNode site, TypeDecl type) {
    ParTypeDecl pt = (ParTypeDecl) type;
    GenericTypeDecl generic = (GenericTypeDecl) pt.genericDecl();
    TypeDecl original = generic.original();
    java.util.List<TypeDecl> args = pt.getParameterization().args;
    List<CaptureVariable> captures = new List<>();
    // The theta substitution maps the type variables of the captured generic
    // type to the argument it is replaced by in this capture.
    Map<TypeVariable, TypeDecl> theta = new LinkedHashMap<>();
    java.util.List<TypeDecl> capturedArgs = new ArrayList<>(args.size());
    for (int i = 0; i < args.size(); ++i) {
      TypeDecl arg = args.get(i);
      if (arg.isWildcard()) {
        // The name is generated with an index so that diagnostics become understandable
        // for the user.
        // TODO(joqvist): This is done with a side effect which is not ideal, but this
        // side effect is not used for anything inside any attribute evaluation so it seems
        // fine for the time being. Should remove this eventually.
        captureCount += 1;
        CaptureVariable capture = new CaptureVariable(
            new Modifiers(new List().add(new Modifier("public"))),
            String.format("capture#%d(%s)", captureCount, arg.typeName()),
            new List<>(), new List<>(), new List<>());
        captures.add(capture);
        arg = capture;
      }
      capturedArgs.add(arg);
      theta.put(generic.getTypeParameter(i), arg);
      if (original != generic && original instanceof GenericTypeDecl) {
        theta.put(((GenericTypeDecl) original).getTypeParameter(i), arg);
      }
    }
    int capture = 0;
    for (int i = 0; i < args.size(); ++i) {
      TypeDecl wildcard = args.get(i);
      if (!wildcard.isWildcard()) {
        continue;
      }
      CaptureVariable cap = captures.getChild(capture++);
      TypeVariable param = generic.getTypeParameter(i);
      if (wildcard instanceof WildcardExtendsType) {
        // Intersect the type parameter bounds with the bound of the upper bounded wildcard.
        TypeDecl extendsType = ((WildcardExtendsType) wildcard).extendsType();
        cap.addBound(extendsType.createBoundAccess());
        for (Access it : param.getTypeBoundList()) {
          TypeDecl bound = it.type();
          if (!extendsType.subtype(bound)) {
            cap.addBound(bound.substituted(theta).createBoundAccess());
          }
        }
      } else {
        for (Access bound : param.getTypeBoundList()) {
          cap.addBound(bound.type().substituted(theta).createBoundAccess());
        }
        if (wildcard instanceof WildcardSuperType) {
          // The capture variable of a lower bounded wildcard has the bound of the
          // wildcard as its lower bound.
          cap.addLowerBound(
              ((WildcardSuperType) wildcard).superType().createBoundAccess());
        }
      }
    }
    return captures;
  }

  // A capture variable is not declared in any type or member, so it has no
  // context to qualify its name with.
  eq CaptureVariable.fullName() = name();

  /**
   * Test if {@code type} is a subtype of one of the lower bounds of this fresh
   * variable, and thereby a subtype of the fresh variable itself.
   */
  syn boolean FreshVariable.aboveLowerBound(TypeDecl type) {
    for (Access lowerBound : getLowerBoundList()) {
      if (type.subtype(lowerBound.type())) {
        return true;
      }
    }
    return false;
  }

  // A fresh variable, unlike a declared type variable, can be a strict
  // supertype of a concrete type when it has a lower bound.
  eq FreshVariable.supertypeClassDecl(ClassDecl type) =
      aboveLowerBound(type) || super.supertypeClassDecl(type);

  eq FreshVariable.supertypeInterfaceDecl(InterfaceDecl type) =
      aboveLowerBound(type) || super.supertypeInterfaceDecl(type);

  eq FreshVariable.supertypeArrayDecl(ArrayDecl type) =
      aboveLowerBound(type) || super.supertypeArrayDecl(type);

  eq FreshVariable.supertypeTypeVariable(TypeVariable type) =
      aboveLowerBound(type) || super.supertypeTypeVariable(type);

  eq FreshVariable.supertypeGLBType(GLBType type) =
      aboveLowerBound(type) || super.supertypeGLBType(type);

  eq Program.getChild().lookupCaptureTypes(ASTNode site, TypeDecl type) =
      wildcards().lookupCaptureTypes(site, type);

  inh List<CaptureVariable> Expr.lookupCaptureTypes(ASTNode site, TypeDecl type);

  syn TypeDecl TypeDecl.substituted(Map<TypeVariable, ? extends TypeDecl> theta) = this;

  eq ParTypeDecl.substituted(Map<TypeVariable, ? extends TypeDecl> theta) {
    if (!involvesTypeParameters() || isRawType()) return this;
    GenericTypeDecl generic = (GenericTypeDecl) genericDecl();
    java.util.List<TypeDecl> args = getParameterization().args;
    ArrayList<TypeDecl> substituted = new ArrayList<>(args.size());
    for (TypeDecl arg : args) {
      substituted.add(arg.substituted(theta));
    }
    return generic.lookupParTypeDecl(substituted);
  }

  eq TypeVariable.substituted(Map<TypeVariable, ? extends TypeDecl> theta) {
    TypeDecl that = theta.get(this);
    return that == null ? this : that;
  }

  eq WildcardExtendsType.substituted(Map<TypeVariable, ? extends TypeDecl> theta) =
      lookupWildcardExtends(extendsType().substituted(theta));

  eq WildcardSuperType.substituted(Map<TypeVariable, ? extends TypeDecl> theta) =
      lookupWildcardSuper(superType().substituted(theta));

  eq ArrayDecl.substituted(Map<TypeVariable, ? extends TypeDecl> theta) =
      componentType().substituted(theta).arrayType();

  eq GLBType.substituted(Map<TypeVariable, ? extends TypeDecl> theta) {
    ArrayList<TypeDecl> bounds = new ArrayList<>(getNumTypeBound());
    boolean changed = false;
    for (int i = 0; i < getNumTypeBound(); ++i) {
      TypeDecl bound = getTypeBound(i).type();
      TypeDecl substituted = bound.substituted(theta);
      changed |= substituted != bound;
      bounds.add(substituted);
    }
    return changed ? lookupGLBType(bounds) : this;
  }

  /**
   * Capture conversion of {@code type} with this expression as the capture site.
   * Each wildcard type argument is replaced by a capture variable of this site.
   *
   * <p>Capture converting the same type at the same site twice yields the same
   * capture variables, so a type flowing through type inference and through the
   * applicability check of the same invocation captures consistently.
   */
  syn lazy TypeDecl Expr.captureConversion(TypeDecl type) {
    if (!(type instanceof ParTypeDecl) || type.isRawType()) {
      return type;
    }
    ParTypeDecl parType = (ParTypeDecl) type;
    if (!(parType.genericDecl() instanceof GenericTypeDecl)) {
      return type;
    }
    ArrayList<TypeDecl> args = new ArrayList<TypeDecl>();
    List<CaptureVariable> captures = null;
    int capture = 0;
    for (TypeDecl arg : parType.getParameterization().args) {
      if (arg.isWildcard()) {
        if (capture == 0) {
          captures = lookupCaptureTypes(this, type);
        }
        arg = captures.getChild(capture++);
      }
      args.add(arg);
    }
    return capture > 0
        ? ((GenericTypeDecl) parType.genericDecl()).lookupParTypeDecl(args)
        : type;
  }

  /**
   * The type of this expression after capture conversion.
   */
  syn lazy TypeDecl Expr.capturedType() = captureConversion(type());

  /**
   * The members of a qualified access are the members of the capture converted
   * type of the qualifier expression, so that a
   * member of a wildcard parameterized type is typed by the capture variables
   * of the qualifier rather than by the wildcards.
   */
  refine LookupMethod eq Dot.getRight().lookupMethod(String name) =
      getLeft().capturedType().memberMethods(name);

  refine VariableScope eq Expr.qualifiedLookupVariable(String name) {
    if (type().accessibleFrom(hostType())) {
      return keepAccessibleFields(capturedType().memberFields(name));
    }
    return emptySet();
  }

  // The class instantiated by a qualified class instance creation is a member
  // of the capture converted type of the qualifier expression.
  // A type access qualifier is not an expression and is not capture converted.
  refine TypeScopePropagation eq Expr.qualifiedLookupType(String name) =
      isTypeAccess()
          ? refined(name)
          : keepAccessibleTypes(capturedType().memberTypes(name));

  // The enclosing instance must match the capture converted qualifier type
  // that the instantiated member class was resolved in.
  refine TypeCheck eq Dot.getRight().enclosingInstance() = getLeft().capturedType();
}
